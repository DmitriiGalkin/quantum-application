{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",

    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "paths": {
      "dto": ["./src/dto/index.ts"],
      "dto/*": ["./src/dto/*"]
    },

    "types": ["node"],
    "esModuleInterop": true,
    "skipLibCheck": true,

    "sourceMap": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/index.ts"]
}
