{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",

    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "paths": {
      "dto/*": ["dto/*"],
      "components/*": ["components/*"],
      "providers/*": ["providers/*"],
      "utils/*": ["utils/*"]
    },

    "types": ["node"],
    "esModuleInterop": true,
    "skipLibCheck": true,

    "sourceMap": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/backend.ts"]
}
