{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "dto": ["./src/dto/index.ts"],
      "dto/*": ["./src/dto/*"],
      "utils/*": ["./src/utils/*"]
    },
    "types": ["node"],
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/backend.ts"]
}
