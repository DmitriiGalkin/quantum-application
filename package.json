{
    "name": "quantum",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite --host 0.0.0.0",
        "dev:ssr": "tsx --watch server.ts",
        "dev:backend": "tsx --watch src/index.ts",
        "build:client": "vite build",
        "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist/server",
        "build:server": "tsc -p tsconfig.ssr.json",
        "build:backend": "tsc -p tsconfig.node.json",
        "build": "npm run build:client && npm run build:ssr && npm run build:server && npm run build:backend",
        "build:production": "NODE_ENV=production npm run build",
        "start": "node src",
        "parser": "tsx src/parser2.ts",
        "lint": "eslint .",
        "typecheck": "tsc --build",
        "check": "npm run lint && npm run typecheck && npm run build",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.312.0",
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/utilities": "^3.2.2",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@mui/icons-material": "^9.0.1",
        "@mui/material": "^9.0.1",
        "@mui/x-date-pickers": "^9.10.1",
        "@tanstack/react-query": "^5.100.9",
        "body-parser": "^1.20.2",
        "compression": "^1.8.1",
        "cors": "^2.8.5",
        "date-fns": "^4.4.0",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-session": "^1.17.3",
        "formidable": "^2.1.1",
        "gigachat": "0.0.20",
        "http-errors": "^2.0.0",
        "jsonwebtoken": "^9.0.0",
        "leaflet": "^1.9.4",
        "markdown-to-jsx": "^9.8.0",
        "mime": "^3.0.0",
        "multer": "^2.1.1",
        "mysql2": "^3.2.0",
        "normalize.css": "^8.0.0",
        "passport": "^0.6.0",
        "passport-yandex": "^0.0.5",
        "react": "^19.2.5",
        "react-dom": "^19.2.5",
        "react-router-dom": "^7.15.0",
        "uuid": "^8.3.2"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/compression": "^1.8.1",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/express-session": "^1.19.0",
        "@types/formidable": "^3.5.1",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/leaflet": "^1.9.21",
        "@types/multer": "^2.1.0",
        "@types/mysql": "^2.15.21",
        "@types/node": "^24.12.2",
        "@types/passport": "^1.0.17",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.1",
        "axios": "^1.17.0",
        "eslint": "^10.2.1",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "globals": "^17.5.0",
        "jsdom": "^30.0.1",
        "prettier": "^3.8.3",
        "tsx": "^4.22.4",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.58.2",
        "vite": "^8.0.10",
        "vite-tsconfig-paths": "^6.1.1",
        "vitest": "^4.1.11"
    }
}
