{
  "compilerOptions": {
    // ... другие опции
    "rootDir": "src",
    "outDir": "./dist",
    "module": "commonjs",
    "target": "ESNext",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "*": ["src/*"]
    }
  },
  "include": ["src/**/*"]
}
